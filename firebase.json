{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "public",
    "predeploy": ["node scripts/prepare-hosting.cjs"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firmware/**",
      "docs/**",
      "test/**",
      ".scratch/**",
      "esp32/**",
      "js/firebase-config.js",
      "**/secrets.h"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      }
    ]
  }
}
